# Copy this file to `.env.local` (or `.env`) and fill in your values.
# See https://nextjs.org/docs/app/building-your-application/configuring/environment-variables for details.

# Public API URL (accessible in browser and server via process.env.NEXT_PUBLIC_API_URL)
NEXT_PUBLIC_API_URL=https://api.example.com

# Database (Prisma + Supabase PostgreSQL)
# Transaction connection pooler (port 6543) with PgBouncer - used by Next.js Server Components / Actions:
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) - used by Prisma CLI for migrations:
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Local development fallback (local PostgreSQL / Docker compose / Supabase local CLI):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"

# Supabase API credentials (optional, for Supabase Auth / Storage)
# NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."

# Server / Container Port (optional, defaults to 3000)
# PORT=3000

# Authentication & JWT Secrets (BidHub)
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-minimum-32-chars"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-minimum-32-chars"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
